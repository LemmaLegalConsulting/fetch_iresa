AZURE_MISTRAL_BASE_URL=
AZURE_MISTRAL_API_KEY=
AZURE_MISTRAL_MODEL=
# Optional comma-separated classifier override, e.g. mistral
ENABLED_CLASSIFIERS=
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
