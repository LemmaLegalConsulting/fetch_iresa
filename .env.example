OPENAI_API_KEY=
OPENAI_BASE_URL_GPT_5_2=
OPENAI_GPT_5_2_API_KEY=
OPENAI_GPT_5_2_API_VERSION=
OPENAI_GPT_5_2_MODEL=gpt-5.2
GPT_5_REASONING_EFFORT=low
CLASSIFIER_TIMEOUT_SECONDS=17
GEMINI_API_KEY=
